---
interface Props {
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<section id={id} class="scroll-mt-24 py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-3xl">{title}</h2>
    {intro && <p class="mt-3 max-w-3xl text-slate-700 dark:text-slate-300">{intro}</p>}
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
