---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { profile } from '../data/site';
import { publications } from '../data/publications';
import { projects } from '../data/projects';
import { education, experience } from '../data/experience';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <section id="home" class="scroll-mt-24 py-16 sm:py-20">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[1.4fr,1fr] lg:px-8">
        <div class="fade-in space-y-6">
          <p class="chip">Academic Research Portfolio</p>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl">{profile.name}</h1>
          <p class="text-xl font-medium text-teal-700 dark:text-teal-300">{profile.headline}</p>
          <p class="max-w-3xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">{profile.intro}</p>
          <div class="flex flex-wrap gap-2">
            {profile.affiliations.map((item) => <span class="chip">{item}</span>)}
          </div>
        </div>
        <aside class="section-card fade-in">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Featured Research Focus</h2>
          <p class="mt-3 text-slate-700 dark:text-slate-300">Zero-Trust security and resilience in Raft-based Atomix clusters supporting distributed ONOS controllers.</p>
          <a href="#research" class="link-accent mt-4 inline-block">Explore current MSc research →</a>
        </aside>
      </div>
    </section>

    <Section id="about" title="About" intro="A concise view of academic background, research interests, technical experience, and evolving research journey.">
      <div class="section-card space-y-4">
        <p>
          Sedzani Ndouvhada is building an academic and engineering profile at the intersection of secure networking and distributed intelligence, with practical interests in SDN controller resilience and trustworthy infrastructure.
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">Research Interests</h3>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700 dark:text-slate-300">
              <li>Software-Defined Networking (SDN)</li>
              <li>Distributed systems and consensus protocols</li>
              <li>Cybersecurity and Zero-Trust architecture</li>
              <li>Artificial intelligence and deep learning</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">Technical Experience</h3>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700 dark:text-slate-300">
              <li>ONOS, Atomix, Raft, OpenDaylight</li>
              <li>Network automation and Python workflows</li>
              <li>Computer vision experimentation</li>
              <li>Software development and systems prototyping</li>
            </ul>
          </div>
        </div>
      </div>
    </Section>

    <Section id="research" title="Research" intro="Current MSc investigation into secure and resilient SDN control planes.">
      <article class="section-card">
        <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100">MSc Topic: Zero-Trust Resilience for Distributed SDN Control</h3>
        <p class="mt-3 text-slate-700 dark:text-slate-300">
          The research investigates Zero-Trust security and resilience mechanisms for Raft-based Atomix clusters that support distributed ONOS controllers. The focus is on robust controller coordination, secure trust boundaries, and fault-tolerant behaviour under realistic distributed conditions.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
          Sensitive implementation details, internal addresses, unpublished source code, and confidential CSIR information are intentionally omitted.
        </p>
      </article>
    </Section>

    <Section id="publications" title="Publications" intro="Verified academic output and placeholders for in-progress metadata.">
      <div class="grid gap-4">
        {publications.map((item) => (
          <article class="section-card">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-700 dark:text-slate-300"><strong>Authors:</strong> {item.authors}</p>
            <p class="mt-1 text-sm text-slate-700 dark:text-slate-300"><strong>Venue:</strong> {item.venue}</p>
            <p class="mt-1 text-sm text-slate-700 dark:text-slate-300"><strong>Date:</strong> {item.date}</p>
            <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">
              <strong>DOI:</strong> {item.doiVerified && item.doi ? <a class="link-accent" href={item.doi} target="_blank" rel="noreferrer">Verified link</a> : 'Placeholder — add verified DOI link.'}
            </p>
            {item.note && <p class="mt-3 text-xs text-slate-600 dark:text-slate-400">{item.note}</p>}
          </article>
        ))}
      </div>
    </Section>

    <Section id="projects" title="Projects" intro="Curated technical work. Only verified public repositories are linked.">
      <div class="grid gap-4 lg:grid-cols-2">
        {projects.map((project) => (
          <article class="section-card">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{project.name}</h3>
            <p class="mt-2 text-slate-700 dark:text-slate-300">{project.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.stack.map((tech) => <span class="chip">{tech}</span>)}
            </div>
            <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
              {project.repoStatus === 'verified' && project.repoUrl
                ? <a class="link-accent" href={project.repoUrl} target="_blank" rel="noreferrer">View repository</a>
                : 'Repository link placeholder — add verified public URL.'}
            </p>
          </article>
        ))}
      </div>
    </Section>

    <Section id="experience" title="Experience & Education" intro="Research appointments and academic path.">
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="space-y-4">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100">Experience</h3>
          {experience.map((item) => (
            <article class="section-card">
              <h4 class="font-semibold text-slate-900 dark:text-slate-100">{item.title}</h4>
              <p class="text-sm text-teal-700 dark:text-teal-300">{item.organisation}</p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{item.period}</p>
              <p class="mt-2 text-slate-700 dark:text-slate-300">{item.summary}</p>
            </article>
          ))}
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100">Education</h3>
          {education.map((item) => (
            <article class="section-card">
              <h4 class="font-semibold text-slate-900 dark:text-slate-100">{item.title}</h4>
              <p class="text-sm text-teal-700 dark:text-teal-300">{item.organisation}</p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{item.period}</p>
              <p class="mt-2 text-slate-700 dark:text-slate-300">{item.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </Section>

    <Section id="cv" title="Academic CV" intro="Download placeholder for the latest CV version.">
      <div class="section-card flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-slate-700 dark:text-slate-300">A complete academic CV can be published here once finalised and verified.</p>
        <a href="/cv/Sedzani-Ndouvhada-CV-placeholder.txt" download class="inline-flex rounded-lg bg-teal-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 dark:bg-teal-500 dark:hover:bg-teal-400">Download CV Placeholder</a>
      </div>
    </Section>

    <Section id="contact" title="Contact" intro="Professional channels for research and engineering collaboration.">
      <div class="section-card grid gap-3 text-slate-700 dark:text-slate-300">
        <p><strong>GitHub:</strong> <a class="link-accent" href="https://github.com/SedzaniZane" target="_blank" rel="noreferrer">github.com/SedzaniZane</a></p>
        <p><strong>ResearchGate:</strong> Placeholder — add verified profile URL.</p>
        <p><strong>LinkedIn:</strong> Placeholder — add verified profile URL.</p>
        <p><strong>Email:</strong> Placeholder — add professional email address.</p>
      </div>
    </Section>
  </main>

  <footer class="border-t border-slate-200 py-8 dark:border-slate-800">
    <div class="mx-auto max-w-6xl px-4 text-sm text-slate-600 sm:px-6 lg:px-8 dark:text-slate-400">
      © {new Date().getFullYear()} Sedzani Ndouvhada · Built with Astro, TypeScript and Tailwind CSS.
    </div>
  </footer>
</BaseLayout>
